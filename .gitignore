# Artefactos de compilación de Cargo/Rust
/target/

# Archivos de respaldo y de bloqueo de dependencias del sistema
**/*.rs.bk

# Los binarios compilados no se versionan
*.exe
*.pdb

# Registros y archivos de prueba temporales
run_err.log
run_out.log
test_sample.md

# Archivos específicos del sistema operativo
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~
.directory

# Directorios y archivos de IDE/editor
.idea/
.vscode/
*.iml
*.swp
*.swo

# Nota: Cargo.lock SÍ se versiona en binarios/aplicaciones (recomendado por Cargo)
